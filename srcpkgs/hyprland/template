# Template file for 'hyprland'
pkgname=hyprland
version=0.56.2
revision=2
archs="x86_64*"
build_style=cmake
hostmakedepends="pkg-config cmake ninja glslang-devel clang hyprwayland-scanner
 hyprwire hyprwire-devel python3 readline-devel SPIRV-Tools-devel
 ca-certificates git"
makedepends="abseil-cpp-devel aquamarine-devel gdk-pixbuf-devel glib-devel
 hyprcursor-devel hyprgraphics-devel hyprlang-devel hyprutils-devel hwids
 lcms2-devel libdisplay-info-devel libei-devel libinput-devel libseat-devel
 libuuid-devel libwebp-devel libzip-devel libXcursor-devel libdrm-devel
 libjpeg-turbo-devel libxcb-devel libxkbcommon-devel librsvg-devel lua55-devel
 MesaLib-devel muparser-devel pango-devel pixman-devel re2 re2-devel
 tomlplusplus-devel udis86-devel wayland-devel wayland-protocols
 xcb-util-errors-devel xcb-util-wm-devel"
nodebug=yes
export CC=clang
export CXX=clang++

CXXFLAGS+=" -include ${XBPS_BUILDDIR}/${pkgname}-${version}/hyprland_compat.hpp"

do_patch() {
	vsed -i 's#requestedModes\.insert_range\(requestedModes\.end\(\), sortedModes [|] std::views::reverse\);#requestedModes.insert(requestedModes.end(), sortedModes.rbegin(), sortedModes.rend());#' \
		src/output/Monitor.cpp
	cp "${FILESDIR}/hyprland_compat.hpp" hyprland_compat.hpp
}

short_desc="Dynamic tiling Wayland compositor with animated visuals"
maintainer="Dicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/Hyprland"
distfiles="https://github.com/hyprwm/Hyprland/releases/download/v${version}/source-v${version}.tar.gz"
checksum=03ad3f5ef152ff44116ffd56fcf808486211ecabf4f0ba567108ee746ba5cd2e
configure_args="-DCMAKE_BUILD_TYPE=None -DNO_HYPRPM=ON
 -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++"

post_install() {
	vlicense LICENSE
}

hyprland-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		if [ -d "$DESTDIR/usr/share/pkgconfig" ]; then
			vmove usr/share/pkgconfig
		fi
	}
}
