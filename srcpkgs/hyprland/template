 hyprwayland-scanner python3"
makedepends="
 aquamarine-devel gdk-pixbuf-devel glib-devel hyprcursor-devel
 hyprgraphics-devel hyprlang-devel hyprutils-devel hwids libei-devel
 libinput-devel libuuid-devel libwebp-devel libXcursor-devel
 libdrm-devel libjpeg-turbo-devel librsvg-devel lua55-devel
 MesaLib-devel muparser-devel pango-devel pixman-devel re2-devel
 udis86-devel wayland-devel wayland-protocols"
