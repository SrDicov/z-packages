# Template file for 'hyprland-preview-share-picker'
pkgname=hyprland-preview-share-picker
version=0.2.1
revision=1
build_style=cargo
make_cmd=cargo
hostmakedepends="cargo git rust"
makedepends="gtk4-devel gtk4-layer-shell hyprland-devel wayland-devel"
depends="gtk4 gtk4-layer-shell hyprland xdg-desktop-portal-hyprland slurp wayland"
short_desc="Preview-based screen-share source picker for Hyprland"
maintainer="Dicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/WhySoBad/hyprland-preview-share-picker"

do_fetch() {
	git clone --depth 1 https://github.com/WhySoBad/hyprland-preview-share-picker.git \
		"${wrksrc}"
	cd "${wrksrc}"
	git fetch --depth 1 origin e2f30ff85486e557018523da45ccbc846e3a499c
	git checkout -q e2f30ff85486e557018523da45ccbc846e3a499c
	# the protocols live in a submodule: take them from a local clone so the
	# build never reaches out to the forge twice
	git clone --depth 1 https://github.com/hyprwm/hyprland-protocols.git \
		"${wrksrc}-protocols"
	git config submodule.lib/hyprland-protocols.url "${wrksrc}-protocols"
	git -c protocol.file.allow=always submodule update
}

do_configure() {
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

post_install() {
	vlicense LICENSE
}
