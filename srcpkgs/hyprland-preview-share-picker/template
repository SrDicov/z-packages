# Template file for 'hyprland-preview-share-picker'
pkgname=hyprland-preview-share-picker
version=0.2.1
revision=2
archs="x86_64*"
build_style=cargo
make_cmd=cargo
hostmakedepends="cargo git pkg-config rust"
makedepends="gtk4-devel gtk4-layer-shell-devel"
depends="gtk4 gtk4-layer-shell hyprland xdg-desktop-portal-hyprland slurp"
short_desc="Preview-based screen-share source picker for Hyprland"
maintainer="Dicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/WhySoBad/hyprland-preview-share-picker"

do_fetch() {
	rm -rf "$wrksrc" "$wrksrc-protocols"
	git clone --depth 1 "${homepage}.git" "${wrksrc}"
	cd "${wrksrc}"
	git fetch --depth 1 origin e2f30ff85486e557018523da45ccbc846e3a499c
	git checkout -q e2f30ff85486e557018523da45ccbc846e3a499c
	git tag -f "v${version}"	# the protocols submodule is pinned some commits behind its main branch
	rm -rf "${wrksrc}-protocols"
	git clone https://github.com/hyprwm/hyprland-protocols.git \
		"${wrksrc}-protocols"
	git config submodule.lib/hyprland-protocols.url "${wrksrc}-protocols"
	git -c protocol.file.allow=always submodule update
}

do_configure() {
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

post_install() {
	local bin
	bin="$(find target -name hyprland-preview-share-picker \
		-path '*release/*' -type f -executable -print -quit)"
	"$bin" schema > schema.json
	vmkdir usr/share/hyprland-preview-share-picker
	vinstall schema.json 644 usr/share/hyprland-preview-share-picker
	vlicense LICENSE
}
