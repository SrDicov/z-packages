	vlicense LICENSE
}
scenefx-nk-devel_package() {
	replaces="scenefx-devel>=0 scenefx-latest-devel>=0"
	provides="scenefx-devel-${version}_${revision} scenefx-latest-devel-${version}_${revision}"
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"

	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
	}
}
