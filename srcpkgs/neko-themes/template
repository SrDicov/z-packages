# Template file for 'neko-themes'
pkgname=neko-themes
version=7.8
revision=3
archs=x86_64
create_wrksrc=yes
makedepends="git"
short_desc="Colección de temas"
maintainer="JavierC <javiercyt@atomicmail.io>"
license="GPL-3.0-or-later"
homepage="https://github.com/Neko-Void-Linux/neko-themes"

do_build() {
	cd "${wrksrc}"
	git clone https://github.com/Neko-Void-Linux/neko-themes.git .
	git clone --depth 1 https://github.com/Neko-Void-Linux/Dracula.git usr/share/themes/Dracula
}

do_install() {
	vcopy usr/share usr
}
