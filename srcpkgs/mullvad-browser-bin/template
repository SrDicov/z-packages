# Template file for 'mullvad-browser-bin'
# Z: glibc-only (binarios precompilados x86_64).
pkgname=mullvad-browser-bin
version=15.0.26
revision=1
archs="x86_64"
create_wrksrc=no
hostmakedepends="bsdtar"
depends="gtk+3 dbus-glib libXtst libXScrnSaver nss alsa-lib libgbm libdrm"
short_desc="Privacy-focused browser by Mullvad and Tor Project"
maintainer="ANOMALI0x00 <ANOMALI0x00@users.noreply.github.com>"
license="MPL-2.0"
homepage="https://mullvad.net/browser"
distfiles="https://github.com/mullvad/mullvad-browser/releases/download/${version}/mullvad-browser_${version}-1_amd64.deb"
checksum=c579692f1f9e4175d0b52eaf848837baf7e5939240f841218e72e0600a09f2a0
replaces="mullvad-browser>=0"
nopie=yes
nostrip=yes

do_extract() {
	mkdir -p ${wrksrc}
	bsdtar -xf ${XBPS_SRCDISTDIR}/${pkgname}-${version}/mullvad-browser_${version}-1_amd64.deb -C ${wrksrc}
	bsdtar -xf ${wrksrc}/data.tar.xz -C ${wrksrc}
}

do_install() {
	vmkdir usr
	cp -a ${wrksrc}/usr/* ${DESTDIR}/usr/
	chmod -R 755 ${DESTDIR}/usr
}
