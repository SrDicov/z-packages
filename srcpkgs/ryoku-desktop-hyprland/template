# Template file for 'ryoku-desktop-hyprland'
pkgname=ryoku-desktop-hyprland
version=0.1.0
revision=1
archs="x86_64*"
hostmakedepends="go"
depends="hyprland hypr-dynamic-cursors ryoku-hypr-plugins hyprglass imgborders
 ryoku-keysounds hyprgrass hyprpolkitagent xdg-desktop-portal-hyprland
 hyprland-preview-share-picker hyprsunset"
short_desc="Ryoku Hyprland compositor, plugins, portal, and WM provider"
maintainer="Ryoku <releases@ryoku.dev>"
license="GPL-3.0-or-later"
homepage="https://ryoku.dev"
_repo_hash=080fd35248e2e7e779868e4a06e1e78560319354
distfiles="https://codeload.github.com/SrDicov/ryoku-void/tar.gz/${_repo_hash}>ryoku-${version}.tar.gz"
checksum=5a6769b90b39aa094b6e721e7d58429fdf2a74ab3b53f1128e2eb8035025bac5
provides="ryoku-desktop-compositor-${version}_${revision}"

_do_payload() {
	GOFLAGS="-buildmode=pie" \
	RYOKU_SRC="$wrksrc" \
	RYOKU_PKGVER="$version" \
	RYOKU_RELEASE="${RYOKU_RELEASE:-local-${version}}" \
	RYOKU_CHANNEL="${RYOKU_CHANNEL:-local}" \
	RYOKU_NAME="${RYOKU_NAME:-Ryoku}" \
	RYOKU_BUILD_DIR="$wrksrc/.xbps-build/ryoku-desktop-hyprland" \
		"$wrksrc/release/packages/ryoku-desktop-hyprland/payload.sh" "$@"
}

do_build() {
	_do_payload build
}

do_install() {
	_do_payload install "$DESTDIR" runit
}
