# Template file for 'hyprgraphics'
pkgname=hyprgraphics
version=0.5.1
revision=4
build_style=cmake
hostmakedepends="pkg-config"
makedepends="MesaLib-devel cairo-devel file-devel gdk-pixbuf-devel
 hyprutils-devel libdrm-devel libjpeg-turbo-devel libwebp-devel
 librsvg-devel pango-devel pixman-devel"
short_desc="Library for rendering graphics"
maintainer="Dicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprgraphics"
distfiles="https://github.com/hyprwm/hyprgraphics/archive/refs/tags/v${version}.tar.gz"
checksum=861ecaad872835922dd5745a612d7a4cc7bfc4babb1d06bc92bc63c2ac013b74
configure_args="-DBUILD_TESTING=OFF"

post_install() {
	vlicense LICENSE
}

hyprgraphics-devel_package() {
	depends="hyprgraphics-${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}