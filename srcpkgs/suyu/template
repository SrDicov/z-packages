# Template file for 'suyu'
pkgname=suyu
version=14.1.0
revision=1
archs="x86_64*"
build_style=cmake
configure_args="-DCMAKE_BUILD_TYPE=Release -DENABLE_QT=ON
 -DYUZU_USE_BUNDLED_QT=OFF -DYUZU_TESTS=OFF -DENABLE_WEB_SERVICE=OFF
 -DENABLE_UPDATE_CHECKER=OFF -DUSE_DISCORD_PRESENCE=OFF -DENABLE_CUBEB=OFF
 -DYUZU_USE_BUNDLED_FFMPEG=OFF -DYUZU_USE_EXTERNAL_FFMPEG=OFF
 -DSUYU_USE_LOCAL_EXTERNALS=ON"
hostmakedepends="pkg-config cmake ninja python3 nasm git"
makedepends="qt6-base-devel qt6-svg-devel qt6-charts-devel qt6-multimedia-devel
 qt6-wayland-devel qt6-tools-devel boost-devel ffmpeg6-devel SDL3-devel
 libusb-devel vulkan-loader-devel Vulkan-Headers Vulkan-Utility-Libraries
 VulkanMemoryAllocator libenet-devel libgamemode-devel frozen fmt-devel
 inih-devel iniparser-devel libzstd-devel liblz4-devel opus-devel zlib-devel
 glslang-devel SPIRV-Tools libglvnd-devel libxcb-devel libxkbcommon-devel
 wayland-devel wayland-protocols libdecor-devel libdrm-devel MesaLib-devel
 alsa-lib-devel pulseaudio-devel libX11-devel libXext-devel libXrandr-devel
 libXcursor-devel libXi-devel libXfixes-devel libXScrnSaver-devel libXtst-devel
 xcb-util-keysyms-devel libunwind-devel libzip-devel"
depends="qt6-svg qt6-wayland"
short_desc="Nintendo Switch emulator"
maintainer="Dicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/suyu-emu/suyu-main"
changelog="https://github.com/suyu-emu/suyu-main/releases"
distfiles="https://github.com/suyu-emu/suyu-main/releases/download/v${version}/suyu-v${version}-source.tar.gz"
checksum=773fc0b3fbd34ab572717e75dd3eeba6ec12d0ef80893d28d37b37fdbab9830a

pre_configure() {
	local qpa
	qpa=$(dirname "$(dirname "$(find /usr/include/qt6/QtGui \
		-name qplatformnativeinterface.h -print -quit)")")
	CXXFLAGS+=" -I$qpa"
}

post_install() {
	vinstall dist/suyu.svg 644 usr/share/icons/hicolor/scalable/apps \
		dev.suyu_emu.suyu.svg
	vinstall dist/dev.suyu_emu.suyu.desktop 644 usr/share/applications
}
