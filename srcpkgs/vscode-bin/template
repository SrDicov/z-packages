# Template file for 'vscode-bin'
pkgname=vscode-bin
version=1.143.0
revision=2
archs="x86_64"
create_wrksrc=yes
hostmakedepends="tar"
depends="libXtst nss alsa-lib gtk+3 libsecret libnotify libXScrnSaver xdg-utils
 desktop-file-utils"
short_desc="Visual Studio Code (official Microsoft binary release)"
maintainer="ANOMALI0x00 <SrDicov@gmail.com>"
license="custom:MICROSOFT SOFTWARE LICENSE TERMS"
homepage="https://code.visualstudio.com"
distfiles="https://vscode.download.prss.microsoft.com/dbazure/download/stable/2d0b7506a36c1d6db9a466440131a8e01eab2289/code-stable-x64-1792533330.tar.gz"
checksum=89302bd9631307a49f3b18a570ce588bf7c53aa4169bf4fb36051a6e76f5e205
conflicts="vscode>=0"
provides="vscode-${version}_${revision}"
nostrip=yes
nopie=yes
noshlibprovides=yes

do_extract() {
	tar -xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}"/*.tar.gz \
		-C "${wrksrc}" --strip-components=1
}

do_install() {
	vmkdir usr/lib/code
	vcopy "*" usr/lib/code/

	if [ -f "${DESTDIR}/usr/lib/code/chrome-sandbox" ]; then
		chmod 4755 "${DESTDIR}/usr/lib/code/chrome-sandbox"
	fi

	vmkdir usr/bin
	ln -sf /usr/lib/code/bin/code "${DESTDIR}/usr/bin/code"

	local icon_src="${DESTDIR}/usr/lib/code/resources/app/resources/linux/code.png"
	if [ -f "$icon_src" ]; then
		vmkdir usr/share/pixmaps
		vcopy "$icon_src" usr/share/pixmaps/vscode.png
	else
		vmkdir usr/share/pixmaps
		ln -sf /usr/lib/code/resources/app/resources/linux/code.png "${DESTDIR}/usr/share/pixmaps/vscode.png"
	fi

	vmkdir usr/share/applications
	vinstall "${FILESDIR}/code.desktop" 644 usr/share/applications
	vinstall "${FILESDIR}/code-url-handler.desktop" 644 usr/share/applications
	vlicense "${DESTDIR}/usr/lib/code/resources/app/LICENSE.rtf"

}
