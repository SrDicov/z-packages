# Template file for 'aquamarine'
pkgname=aquamarine
version=0.16.0
revision=1
archs="x86_64*"
build_style=cmake
configure_args="-DBUILD_TESTING=OFF"
hostmakedepends="pkg-config pixman-devel"
makedepends="MesaLib-devel hwids hyprutils-nk-devel hyprwayland-scanner
 libdrm-devel libdisplay-info-devel libinput-devel libseat-devel pixman-devel
 wayland-devel wayland-protocols"
short_desc="Library for compositing and rendering"
maintainer="Dicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/aquamarine"
distfiles="https://github.com/hyprwm/aquamarine/archive/refs/tags/v${version}.tar.gz"
checksum=42339c3096c9de6582c0d71bc86b7e63334a3faf6a2b917d385ad093caf66c3c

post_install() {
	vlicense LICENSE
	for pc in "$PKGDESTDIR"/usr/lib{,64}/pkgconfig/aquamarine.pc; do
		if [ -f "$pc" ]; then
			echo 'Requires: libseat libdisplay-info' >>"$pc"
		fi
	done
}


aquamarine-devel_package() {
	depends="aquamarine-${version}_${revision} libseat-devel libdisplay-info-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}
