# Template file for 'aquamarine'
pkgname=aquamarine
version=0.15.1
revision=4
build_style=cmake
hostmakedepends="pkg-config pixman-devel"
makedepends="MesaLib-devel hwids hyprutils-devel hyprwayland-scanner
 libdrm-devel libdisplay-info-devel libinput-devel libseat-devel
 pixman-devel wayland-devel wayland-protocols"
short_desc="Library for compositing and rendering"
maintainer="Dicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/aquamarine"
distfiles="https://github.com/hyprwm/aquamarine/archive/refs/tags/v${version}.tar.gz"
checksum=2f9de98c0bd1b7b1b09c576e390a2fef436449762fb334163c414f0c300296f2
configure_args="-DBUILD_TESTING=OFF"

post_install() {
	vlicense LICENSE
	for pc in "$XBPS_DESTDIR"/usr/lib{,64}/pkgconfig/aquamarine.pc; do
		if [ -f "$pc" ]; then
			echo 'Requires: libseat libdisplay-info' >>"$pc"
			sed -i 's|^libdir=.*|libdir=/usr/lib|' "$pc"
		fi
	done
}


aquamarine-devel_package() {
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}