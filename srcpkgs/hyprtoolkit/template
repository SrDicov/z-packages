# Template file for 'hyprtoolkit'
pkgname=hyprtoolkit
version=0.6.0
revision=1
archs="x86_64*"
build_style=cmake
configure_args="-DBUILD_TESTING=OFF"
hostmakedepends="pkg-config hyprwayland-scanner wayland-devel wayland-protocols"
makedepends="abseil-cpp-devel aquamarine-devel cairo-devel hyprgraphics-devel
 hyprlang-devel hyprutils-nk-devel iniparser-devel libdrm-devel libgbm-devel
 libglvnd-devel libxkbcommon-devel pango-devel pixman-devel wayland-devel
 wayland-protocols"
short_desc="Modern C++ Wayland-native GUI toolkit"
maintainer="Dicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprtoolkit"
distfiles="https://github.com/hyprwm/hyprtoolkit/archive/refs/tags/v${version}.tar.gz"
checksum=53c41be72af97d9ede274a63c9c1034c58726d862905763ed6e5a564ae42ba6b

post_install() {
	vlicense LICENSE
}

hyprtoolkit-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}
