# Template file for 'hyprtoolkit'
pkgname=hyprtoolkit
version=0.5.1
revision=1
archs="x86_64*"
build_style=cmake
configure_args="-DBUILD_TESTING=OFF"
hostmakedepends="pkg-config hyprwayland-scanner wayland-devel wayland-protocols"
makedepends="abseil-cpp-devel aquamarine-devel cairo-devel hyprgraphics-devel librsvg-devel libpng-devel libwebp-devel libjpeg-turbo-devel libheif-devel libjxl-devel file-devel
 hyprlang-devel hyprutils-nk-devel iniparser-devel libdrm-devel libgbm-devel
 libglvnd-devel libxkbcommon-devel pango-devel pixman-devel wayland-devel
 wayland-protocols"
short_desc="Modern C++ Wayland-native GUI toolkit"
maintainer="Dicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprtoolkit"
distfiles="https://github.com/hyprwm/hyprtoolkit/archive/refs/tags/v${version}.tar.gz"
checksum=f9f481dc18ec1d293dbd4e508e784c3781d067972b053bf4db0a12cf506ca31d

post_install() {
	vlicense LICENSE
}

hyprtoolkit-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}
	 abseil-cpp-devel aquamarine-devel cairo-devel hyprgraphics-devel
	 hyprlang-devel hyprutils-nk-devel iniparser-devel libdrm-devel
	 libgbm-devel libglvnd-devel libxkbcommon-devel pango-devel pixman-devel
	 wayland-devel wayland-protocols"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}
