# Template file for 'hyprtoolkit'
pkgname=hyprtoolkit
version=0.6.0
revision=1
build_style=cmake
configure_args="-DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++
 -DCMAKE_BUILD_TYPE=None"
hostmakedepends="pkg-config clang hyprwayland-scanner"
makedepends="aquamarine-devel hyprgraphics-devel hyprutils-devel hyprlang-devel
 wayland-devel pixman-devel libdrm-devel MesaLib-devel libxkbcommon-devel
 pango-devel cairo-devel iniparser-devel abseil-cpp-devel"
short_desc="Hyprland toolkit for building native apps"
maintainer="Dicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/hyprwm/hyprtoolkit"
distfiles="https://github.com/hyprwm/hyprtoolkit/archive/refs/tags/v${version}.tar.gz"
checksum=53c41be72af97d9ede274a63c9c1034c58726d862905763ed6e5a564ae42ba6b

hyprtoolkit-devel_package() {
	depends="hyprtoolkit-${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
		vmove usr/lib/cmake
	}
}
