do_extract() {
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/matrix_asm_x86_64" \
		"${wrksrc}/matrix_asm_x86_64"
}

do_install() {
	vbin matrix_asm_x86_64 matrix-asm
}
