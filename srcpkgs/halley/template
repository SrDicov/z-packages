# Z: glibc-only (binarios precompilados x86_64).
pkgname=halley
version=0.5.6
revision=1
archs="x86_64"
depends="xwayland-satellite dbus seatd"
short_desc="Spatial Wayland compositor with per-monitor infinite canvas"
maintainer="mikuri12 <https://github.com/mikuri12>"
license="GPL-3.0-only"
homepage="https://github.com/mikuri12/halley"
distfiles="https://github.com/mikuri12/halley/releases/download/v${version}/halley-binaries-v${version}-x86_64.tar.gz"
checksum="95d7293acc2fb068ecbcd4b961c9ab385ee3667d99a8867b3577369cdaea6cf0"
wrksrc="halley-binaries"

do_build() {
	:
}

do_install() {
	vbin bin/halley
	vbin bin/halleyctl
	vbin bin/xdg-desktop-portal-halley
	vbin bin/halley-session

	vmkdir usr/share/wayland-sessions
	vinstall share/wayland-sessions/halley.desktop 644 usr/share/wayland-sessions

	vmkdir usr/share/xdg-desktop-portal/portals
	vinstall share/xdg-desktop-portal/portals/halley.portal 644 usr/share/xdg-desktop-portal/portals
	vinstall share/xdg-desktop-portal/halley-portals.conf 644 usr/share/xdg-desktop-portal

	vmkdir usr/share/dbus-1/services
	vinstall share/dbus-1/services/org.freedesktop.impl.portal.desktop.halley.service 644 usr/share/dbus-1/services
}
