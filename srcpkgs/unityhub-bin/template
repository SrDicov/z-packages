# Template file for 'unityhub-bin'
pkgname=unityhub-bin
version=3.22.3
revision=1
archs="x86_64"
hostmakedepends="tar zstd xz"
depends="gtk+3 libnotify nss xdg-utils at-spi2-core libdrm mesa libxcb
 ca-certificates gnupg libXScrnSaver libXtst libuuid libsecret tar zip unzip
 alsa-lib desktop-file-utils glib"
short_desc="Official Unity Hub"
maintainer="Javierc <javiercyt@atomicmail.io>"
license="custom:Unity Terms of Service"
homepage="https://unity.com/hub"
distfiles="https://public-cdn.cloud.unity3d.com/hub/prod/UnityHubSetup-amd64.deb>unityhub-${version}.deb"
checksum=a3ab6c61cbedbcd4baed4da06834a1737c4419f5c8c761fe326136f87435481f
replaces="unityhub>=0"
nostrip=yes

do_extract() {
	local debfile="${XBPS_SRCDISTDIR}/${pkgname}-${version}/unityhub-${version}.deb"
	ar x "${debfile}"
	tar xf data.tar.*
}

do_install() {
	vcopy usr/. usr
	vlicense "${FILESDIR}/LICENSE"
}
