#!/bin/sh
case "${ACTION}" in
post)
	glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
	gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
	update-desktop-database /usr/share/applications 2>/dev/null || true
	cat <<EOF
================================================================
Singularity Desktop installed. To use it on Void (runit):

  1. Enable the required services (as root):
       ln -s /etc/sv/dbus /var/service/
       ln -s /etc/sv/elogind /var/service/
     For the full desktop (skip any you already run):
       ln -s /etc/sv/NetworkManager /var/service/   # or keep dhcpcd/connman
       ln -s /etc/sv/bluetoothd /var/service/
       ln -s /etc/sv/cupsd /var/service/
       ln -s /etc/sv/rtkit /var/service/
     (fprintd is D-Bus activated; no service to enable.)

  2. Set up the greeter (greetd + runit):
       sudo bash /usr/share/doc/singularity-desktop/install-greeter.sh

  3. Reboot and log in from the greeter.

Do NOT run deploy-to-host.sh: the package already installs the session
entry, the portal/keyring D-Bus activation and the polkit agent into
/usr. That script only exists for source installs under /opt/local.
================================================================
EOF
	;;
esac
