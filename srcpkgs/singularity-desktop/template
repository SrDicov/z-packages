if [ "$XBPS_TARGET_LIBC" = musl ]; then
	broken="needs glibc-only gesture runtime, no -Dgestures=false yet"
fi

do_extract() {
	local _s _src=$XBPS_SRCDISTDIR/$pkgname-$version
	local _rt=subprojects/singularity-gestures/runtime

	vsrcextract --strip-components=1 ${pkgname}-${version}.tar.gz
	for _s in ${_submodules}; do
		mkdir -p subprojects/$_s
		bsdtar -xzf $_src/$_s.tar.gz -C subprojects/$_s --strip-components=1
	done
	mkdir -p "$_rt/include" "$XBPS_BUILDDIR/vetro"
	unzip -j -q -o $_src/mediapipe.whl mediapipe/tasks/c/libmediapipe.so -d $_rt
	vsrccopy hand_landmarker.task face_landmarker.task mobileone_s0_gaze.onnx $_rt
	cp $_src/vetro "$XBPS_BUILDDIR/vetro/vetro"
	chmod 0755 "$XBPS_BUILDDIR/vetro/vetro"
	mkdir -p "$XBPS_BUILDDIR/.onnx"
	bsdtar -xzf $_src/onnxruntime.tgz -C "$XBPS_BUILDDIR/.onnx" --strip-components=1
	mv "$XBPS_BUILDDIR/.onnx/lib/libonnxruntime.so.1.23.2" $_rt/libonnxruntime.so
	cp "$XBPS_BUILDDIR/.onnx/include/onnxruntime_c_api.h" \
		"$XBPS_BUILDDIR/.onnx/include/onnxruntime_ep_c_api.h" \
		$_rt/include/
	rm -rf "$XBPS_BUILDDIR/.onnx"
}

post_extract() {
	msg_normal "Bootstrapping gesture runtime...\n"
	vsed -i 's|/usr/bin/python3\.12|python3|' \
		subprojects/singularity-gestures/scripts/bootstrap-runtime.sh
	PYTHON=python3 bash subprojects/singularity-gestures/scripts/bootstrap-runtime.sh
}

pre_configure() {
	PATH="$XBPS_BUILDDIR/vetro:$PATH"
}

post_patch() {
	for _s in libsingularity singularity-shell singularity-session; do
		patch -d subprojects/$_s -p1 -i "$FILESDIR"/$_s-void.patch
	done
}

do_install() {
	DESTDIR="${DESTDIR}" meson install -C build
	vmkdir usr/lib/singularity/gestures/runtime
	for _so in libmediapipe.so libonnxruntime.so; do
		mv "${DESTDIR}"/usr/share/singularity/gestures/runtime/$_so \
			"${DESTDIR}"/usr/lib/singularity/gestures/runtime/$_so
		ln -s ../../../lib/singularity/gestures/runtime/$_so \
			"${DESTDIR}"/usr/share/singularity/gestures/runtime/$_so
	done
	vinstall scripts/deploy-to-host.sh 755 usr/share/doc/singularity-desktop
	vinstall scripts/install-greeter.sh 755 usr/share/doc/singularity-desktop
}
