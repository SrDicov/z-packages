# Template file for 'hyprlang'
pkgname=hyprlang
version=0.6.4
revision=1
archs="x86_64*"
build_style=cmake
configure_args="-DBUILD_TESTING=OFF"
hostmakedepends="pkg-config pixman-devel"
makedepends="hyprutils-nk-devel"
short_desc="Hypr config language implementation library"
maintainer="Dicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprlang"
distfiles="https://github.com/hyprwm/hyprlang/archive/refs/tags/v${version}.tar.gz"
checksum=cd7395eaeb1eee90ebeba9c1330a7635709dd0900ebbe349a7aa5702ba4d613f

post_install() {
	vlicense LICENSE
}

hyprlang-devel_package() {
	depends="hyprlang-${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}
