# Template file for 'imgborders'
pkgname=imgborders
version=2.1.0
revision=1
archs="x86_64*"
build_style=cmake
hostmakedepends="pkg-config"
makedepends="aquamarine-devel cairo-devel glslang-devel hyprcursor-devel
 hyprgraphics-devel librsvg-devel libpng-devel libwebp-devel libjpeg-turbo-devel libheif-devel libjxl-devel file-devel hyprland-devel hyprlang-devel hyprutils-nk-devel
 libdisplay-info-devel libdrm-devel libinput-devel libseat-devel libxcb-devel
 libxkbcommon-devel libzip-devel lua55-devel MesaLib-devel pango-devel
 pixman-devel tomlplusplus-devel wayland-devel xcb-util-errors-devel
 xcb-util-wm-devel"
depends="hyprland"
short_desc="Hyprland plugin: image borders around windows"
maintainer="Dicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://codeberg.org/zacoons/imgborders"
distfiles="https://codeberg.org/zacoons/imgborders/archive/${version}.tar.gz"
checksum=81211cdae8deac0aac44fa469a8de0e33df7e0cb96ae90e467f7b8a9a21ecc29

export CPATH="/usr/include/pixman-1:/usr/include/lua5.5:/usr/include/libdrm:/usr/include/hyprland/src"

post_install() {
	vmkdir usr/lib/hyprland/plugins
	# cmake install puts libimgborders.so in usr/lib (default); move/link into hyprland plugins dir
	if [ -f "${DESTDIR}/usr/lib/libimgborders.so" ]; then
		mv "${DESTDIR}/usr/lib/libimgborders.so" \
			"${DESTDIR}/usr/lib/hyprland/plugins/imgborders.so"
	elif [ -f "${DESTDIR}/usr/lib64/libimgborders.so" ]; then
		mv "${DESTDIR}/usr/lib64/libimgborders.so" \
			"${DESTDIR}/usr/lib/hyprland/plugins/imgborders.so"
	else
		# fallback: search
		so="$(find "${DESTDIR}" -name 'libimgborders.so' -type f | head -n1)"
		[ -n "$so" ] || return 1
		mv "$so" "${DESTDIR}/usr/lib/hyprland/plugins/imgborders.so"
	fi
	local h=/usr/include/hyprland/src/version.h
	local abi v
	abi="$(sed -n 's/^#define GIT_COMMIT_HASH *"\([^"]*\)".*/\1/p' "$h")"
	for v in AQUAMARINE:aq HYPRUTILS:hu HYPRGRAPHICS:hg HYPRCURSOR:hc \
		HYPRLANG:hlg; do
		abi="${abi}_${v#*:}_$(sed -n "s/^#define ${v%:*}_VERSION *\"\([^\"]*\)\".*/\1/p" \
			"$h" | sed 's/\.[^.]*$//')"
	done
	printf '%s\n' "$abi" >"${PKGDESTDIR}/usr/lib/hyprland/plugins/imgborders.abi"
}
