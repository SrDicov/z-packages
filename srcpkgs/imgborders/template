# Template file for 'imgborders'
pkgname=imgborders
version=1.0.2
revision=3
archs="x86_64*"
build_style=cmake
hostmakedepends="cmake curl git pkg-config"
makedepends="aquamarine-devel cairo-devel glslang-devel hyprcursor-devel
 hyprgraphics-devel hyprland-devel hyprlang-devel hyprutils-devel
 libdisplay-info-devel libdrm-devel libinput-devel libseat-devel libxcb-devel
 libxkbcommon-devel libzip-devel lua55-devel MesaLib-devel pango-devel
 pixman-devel tomlplusplus-devel wayland-devel xcb-util-errors-devel
 xcb-util-wm-devel"
depends="hyprland"
short_desc="Hyprland plugin: image borders around windows"
maintainer="Dicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://codeberg.org/zacoons/imgborders"

export CPATH="/usr/include/pixman-1:/usr/include/lua5.5:/usr/include/libdrm:/usr/include/hyprland/src"

_bundle_url="https://raw.githubusercontent.com/SrDicov/ryoku-void/main/release/packages/imgborders/imgborders.bundle"
_bundle_sha256="48187e72ca62fc0b8d12809ca02082b8d27016516d84527a19abb3ff007d6a7d"

do_fetch() {
	curl -fsSL -o imgborders.bundle "${_bundle_url}"
	echo "${_bundle_sha256}  imgborders.bundle" | sha256sum -c -
	git clone -q imgborders.bundle "${wrksrc}"
	cd "${wrksrc}"
	local hv commit
	hv="$(sed -n 's/^#define GIT_COMMIT_HASH *"\([^"]*\)".*/\1/p' \
		/usr/include/hyprland/src/version.h)"
	commit="$(grep -F "\"$hv\"" hyprpm.toml | grep -oE '[0-9a-f]{40}' | sed -n 2p)"
	if [ -n "$commit" ]; then
		git checkout -q "$commit"
	fi
}

post_install() {
	vmkdir usr/lib/hyprland/plugins
	vinstall ${DESTDIR}/usr/lib/libimgborders.so 755 \
	 usr/lib/hyprland/plugins imgborders.so
	local h=/usr/include/hyprland/src/version.h
	local abi v
	abi="$(sed -n 's/^#define GIT_COMMIT_HASH *"\([^"]*\)".*/\1/p' "$h")"
	for v in AQUAMARINE:aq HYPRUTILS:hu HYPRGRAPHICS:hg HYPRCURSOR:hc \
		HYPRLANG:hlg; do
		abi="${abi}_${v#*:}_$(sed -n "s/^#define ${v%:*}_VERSION *\"\([^\"]*\)\".*/\1/p" \
			"$h" | sed 's/\.[^.]*$//')"
	done
	printf '%s\n' "$abi" >"${PKGDESTDIR}/usr/lib/hyprland/plugins/imgborders.abi"
}
