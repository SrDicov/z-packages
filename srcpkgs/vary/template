# Template file for 'vary'
pkgname=vary
version=0.2.5
revision=1
wrksrc="Vary-${version}"
build_style=cargo
hostmakedepends="git"
depends="git"
short_desc="Void User Repository (VUR) helper and build automator"
maintainer="Dicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/SrDicov/Vary"
distfiles="https://github.com/SrDicov/Vary/archive/refs/tags/v${version}.tar.gz"
checksum=2ccbb6fd9574771bcaca3cf14066d96046adcce94357e170469f8f9d3444abd2

# upstream releases without relocking Cargo.lock, so --locked from
# build_style=cargo fails; build like upstream CI does and let cargo
# refresh the lock.
do_build() {
	cargo build --release
}

post_install() {
	vdoc README.md
	vdoc docs/AUR2XBPS.md
	vdoc docs/VURINFO.md
	vinstall etc/vary.conf.example 644 usr/share/examples/vary
	vlicense LICENSE
}
