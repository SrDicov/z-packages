checksum=8eba378121d0f8805a113995fd915a95f9a7f58dfd71a74236c4df869e1cd919
replaces="artcraft-launcher-bin>=0"

case "$XBPS_TARGET_MACHINE" in
i686*)
	make_check=no # el fixture de test solo trae assets linux-x86_64
	;;
esac

post_install() {
	vlicense LICENSE-MIT
	vlicense LICENSE-APACHE
	vlicense NOTICE
	vinstall packaging/linux/ai.storyteller.artcraft-launcher.desktop 644 usr/share/applications
	vmkdir usr/share/icons
	vcopy assets/app-icon/hicolor usr/share/icons
	vinstall assets/app-icon/hicolor/512x512/apps/ai.storyteller.artcraft-launcher.png 644 usr/share/pixmaps
}
