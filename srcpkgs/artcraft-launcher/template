# Template file for 'artcraft-launcher'
pkgname=artcraft-launcher
version=0.19.2
revision=1
build_style=cargo
make_build_args="-p artcraft-launcher"
make_install_args="--path apps/artcraft-launcher"
make_check_args="-- --skip
 a_not_installed_card_is_grey_until_the_pointer_is_over_it"
hostmakedepends="cargo rust pkg-config"
makedepends="wayland-devel libxkbcommon-devel"
depends="hicolor-icon-theme ca-certificates"
checkdepends="procps-ng"
short_desc="Install, update and launch the Craft App Suite"
maintainer="Dicov <SrDicov@gmail.com>"
license="MIT, Apache-2.0"
homepage="https://getartcraft.com/apps"
changelog="https://github.com/storytold/craft-launcher/releases"
