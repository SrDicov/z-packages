# Template file for 'hyprwire'
pkgname=hyprwire
version=0.3.1
revision=5
build_style=cmake
hostmakedepends="pkg-config"
makedepends="hyprutils-devel libffi-devel pixman-devel pugixml-devel"
short_desc="Wire protocol library and code generator for the Hyprland IPC"
maintainer="Dicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/hyprwm/hyprwire"
distfiles="https://github.com/hyprwm/hyprwire/archive/refs/tags/v${version}.tar.gz"
checksum="92a673d40ae6a7d66fbcd0a34ec071e026e17eaeeb0040c3375e4b2a80dba737"

post_install() {
	vlicense LICENSE
}

do_patch() {
	# std::vector::append_range is C++26 and Void ships libstdc++ 14
	find src -name '*.cpp' -exec sed -i -E \
		-e 's/^(\s*)([A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*)\.append_range\(([A-Za-z_][A-Za-z0-9_]*)\);$/\1\2.insert(\2.end(), \4.begin(), \4.end());/' \
		-e 's/^(\s*)([A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*)\.append_range\((.*)\);$/\1{ auto tmp_ = \4; \2.insert(\2.end(), tmp_.begin(), tmp_.end()); }/' \
		{} +
}

hyprwire-devel_package() {
	depends="hyprwire-${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
		vmove usr/lib/cmake
	}
}
