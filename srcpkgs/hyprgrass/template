# Template file for 'hyprgrass'
pkgname=hyprgrass
version=0.8.2
revision=1
build_style=meson
hostmakedepends="git meson ninja pkg-config"
makedepends="
 aquamarine-devel cairo-devel hyprcursor-devel hyprgraphics-devel
 hyprland-devel hyprlang-devel hyprutils-devel libdrm-devel
 libinput-devel libxcb-devel libxkbcommon-devel lua55-devel MesaLib-devel
 pango-devel pixman-devel wayland-devel xcb-util-errors-devel
 xcb-util-wm-devel
"
depends="hyprland lua55"
short_desc="Hyprland plugin: touchscreen gestures for windows and workspaces"
maintainer="Dicov <SrDicov@gmail.com>"
license="Apache-2.0"
homepage="https://github.com/horriblename/hyprgrass"

export PKG_CONFIG_PATH="${XBPS_BUILDDIR}/shim-pc${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

do_fetch() {
	git clone --depth 1 https://github.com/horriblename/hyprgrass.git "${wrksrc}"
	cd "${wrksrc}"
	# the plugin is ABI-locked to the compositor: take the commit hyprpm
	# pins for the Hyprland this build links against
	local hv commit
	hv="$(sed -n 's/^#define GIT_COMMIT_HASH *"\([^"]*\)".*/\1/p' \
		/usr/include/hyprland/src/version.h)"
	commit="$(grep -F "\"$hv\"" hyprpm.toml | grep -oE '[0-9a-f]{40}' | sed -n 2p)"
	if [ -n "$commit" ]; then
		git fetch --depth 1 origin "$commit"
		git checkout -q "$commit"
	fi
	git submodule update --init --recursive
}

do_patch() {
	# Void's glm is header only and ships no glm.pc, and meson asks for one
	mkdir -p "${XBPS_BUILDDIR}/shim-pc"
	cat >"${XBPS_BUILDDIR}/shim-pc/glm.pc" <<_EOF
prefix=/usr
includedir=/usr/include

Name: glm
Description: C++ OpenGL math library (header-only)
Version: 1.0.3
Cflags: -I${includedir}
_EOF
	# the plugin asks for the plain lua module, but Hyprland runs on Lua 5.5
	# and Void's lua is 5.3, so the build resolves the 5.5 headers instead
	cat >"${XBPS_BUILDDIR}/shim-pc/lua.pc" <<_EOF
prefix=/usr
exec_prefix=/usr
libdir=/usr/lib
includedir=/usr/include/lua5.5

Name: Lua
Description: An Extensible Extension Language
Version: 5.5.1
Libs: -L${libdir} -llua5.5
Libs.private: -lm -ldl
Cflags: -I${includedir}
_EOF
}

post_install() {
	vlicense LICENSE
	# Hyprland loads plugins from its own directory, meson installs them flat
	vmkdir usr/lib/hyprland/plugins
	vmove usr/lib/libhyprgrass.so usr/lib/hyprland/plugins/hyprgrass.so
	# the receipt records the compositor ABI the plugin was built for
	local h=/usr/include/hyprland/src/version.h
	local abi v
	abi="$(sed -n 's/^#define GIT_COMMIT_HASH *"\([^"]*\)".*/\1/p' "$h")"
	for v in AQUAMARINE:aq HYPRUTILS:hu HYPRGRAPHICS:hg HYPRCURSOR:hc \
		HYPRLANG:hlg; do
		abi="${abi}_${v#*:}_$(sed -n "s/^#define ${v%:*}_VERSION *\"\([^\"]*\)\".*/\1/p" \
			"$h" | sed 's/\.[^.]*$//')"
	done
	printf '%s\n' "$abi" >"${PKGDESTDIR}/usr/lib/hyprland/plugins/hyprgrass.abi"
}
