# Template file for 'labwc-singularity'
pkgname=labwc-singularity
version=0.20.2
revision=5
archs="x86_64 x86_64-musl"
build_style=meson
configure_args="--prefix=/usr --libdir=lib --buildtype=release
 -Dxwayland=enabled -Dc_args=-D_GNU_SOURCE --force-fallback-for=scenefx-0.5
 -Dscenefx:default_library=static -Dscenefx:examples=false"
hostmakedepends="meson ninja pkg-config gettext scdoc wayland-devel
 wayland-protocols bsdtar patch"
makedepends="cairo-devel glib-devel libpng-devel librsvg-devel libsfdo-devel
 libxml2-devel pango-devel pixman-devel wlroots0.20-devel scenefx-devel
 xorg-server-xwayland xcb-util-wm-devel libglvnd-devel libdisplay-info-devel
 libliftoff-devel libdrm-devel libinput-devel libseat-devel libxkbcommon-devel
 eudev-libudev-devel"
depends="xorg-server-xwayland mesa-dri dejavu-fonts-ttf xkeyboard-config"
short_desc="Singularity fork of the labwc Wayland compositor"
maintainer="Dicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/singularityos-lab/labwc"
_commit="8473ea4b722b7f255590078ac9868538d853f5dd"
_repository="https://github.com/singularityos-lab/labwc.git"
distfiles="https://github.com/singularityos-lab/labwc/archive/${_commit}.tar.gz>labwc-singularity-${version}.tar.gz
 https://github.com/wlrfx/scenefx/archive/37ccd723bef49e6891156ffafce8f549f01446cc.tar.gz>scenefx.tar.gz"
checksum="1d56d7f2003f35854c3423d65f83fd45c274faf1b3f574bc5890256487d72a05
 7f595ead422fa12c1aae2af65402d1cf78ac6a8726cfb5a511b208a788981e13"
provides="labwc-${version}_${revision}"
replaces="labwc>=0"
conflicts="labwc>=0"

do_extract() {
	vsrcextract --strip-components=1 labwc-singularity-${version}.tar.gz
	mkdir -p subprojects/scenefx
	bsdtar -xzf "${XBPS_SRCDISTDIR}/${pkgname}-${version}/scenefx.tar.gz" \
		-C subprojects/scenefx --strip-components=1
	patch -d subprojects/scenefx -p1 \
		-i "${PWD}/subprojects/packagefiles/scenefx-liquid.patch"
	patch -d subprojects/scenefx -p1 \
		-i "${PWD}/subprojects/packagefiles/scenefx-software-sync.patch"
	patch -d subprojects/scenefx -p1 \
		-i "${FILESDIR}/scenefx-musl-always-inline.patch"
}
