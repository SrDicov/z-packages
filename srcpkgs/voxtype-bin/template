# Template file for 'voxtype-bin'
pkgname=voxtype-bin
version=1.1.1
revision=1
archs="x86_64"
nodebug=yes
nostrip=yes
skip_extraction="voxtype.gz voxtype-osd.gz"
depends="pipewire wireplumber"
short_desc="Offline speech-to-text daemon for Wayland compositors"
maintainer="Dicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/peteonrails/voxtype"
distfiles="https://github.com/peteonrails/voxtype/releases/download/v${version}/voxtype-${version}-linux-x86_64-onnx-avx2>voxtype.gz
 https://github.com/peteonrails/voxtype/releases/download/v${version}/voxtype-${version}-linux-x86_64-osd-quickshell>voxtype-osd.gz"
checksum="683683ef66de6616e415efa7f7893873d7f8d5bfe4b2b05ce3cf3e467d4733d5
 8947b7ea576096f327e97a488bb6245ba34a71d93ced46fb3b7800e97cca6905"

do_install() {
	local src="${XBPS_SRCDISTDIR}/${pkgname}-${version}"
	vmkdir usr/bin
	install -Dm755 "${src}/voxtype.gz" ${DESTDIR}/usr/lib/voxtype/voxtype
	install -Dm755 "${src}/voxtype-osd.gz" ${DESTDIR}/usr/lib/voxtype/voxtype-osd
	ln -s /usr/lib/voxtype/voxtype ${DESTDIR}/usr/bin/voxtype
	ln -s /usr/lib/voxtype/voxtype-osd ${DESTDIR}/usr/bin/voxtype-osd
}
