do_install() {
	vmkdir usr/lib/voxtype
	vcopy voxtype-${version}-linux-x86_64-onnx-avx2 \
		usr/lib/voxtype/voxtype
	vcopy voxtype-${version}-linux-x86_64-osd-quickshell \
		usr/lib/voxtype/voxtype-osd
	vbin usr/lib/voxtype/voxtype
	vbin usr/lib/voxtype/voxtype-osd
}