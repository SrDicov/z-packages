# Template file for 'hyprcursor'
pkgname=hyprcursor
version=0.1.13
revision=4
build_style=cmake
hostmakedepends="pkg-config pixman-devel"
makedepends="hyprlang-devel libzip-devel librsvg-devel tomlplusplus-devel"
short_desc="Library for material cursors"
maintainer="Dicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprcursor"
distfiles="https://github.com/hyprwm/hyprcursor/archive/refs/tags/v${version}.tar.gz"
checksum=82af8b2ce27242ffdd6baebaa71b3f6c8665dc25c52bfcfccc16912622896af8
configure_args="-DBUILD_TESTING=OFF"

post_install() {
	vlicense LICENSE
	for pc in "$XBPS_DESTDIR"/usr/lib{,64}/pkgconfig/hyprcursor.pc; do
		if [ -f "$pc" ]; then
			echo 'Requires: libzip tomlplusplus' >>"$pc"
			sed -i 's|^libdir=.*|libdir=/usr/lib|' "$pc"
		fi
	done
}


hyprcursor-devel_package() {
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}
