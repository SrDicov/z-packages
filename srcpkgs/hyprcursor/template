# Template file for 'hyprcursor'
pkgname=hyprcursor
version=0.1.14
revision=1
archs="x86_64*"
build_style=cmake
configure_args="-DBUILD_TESTING=OFF"
hostmakedepends="pkg-config pixman-devel"
makedepends="hyprlang-devel libzip-devel librsvg-devel tomlplusplus-devel"
short_desc="Library for material cursors"
maintainer="Dicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprcursor"
distfiles="https://github.com/hyprwm/hyprcursor/archive/refs/tags/v${version}.tar.gz"
checksum=f835995a1225ab169723d5e4e7510e31231dbb3048c4da6de6f6a51794e4cb38

post_install() {
	vlicense LICENSE
	for pc in "$PKGDESTDIR"/usr/lib{,64}/pkgconfig/hyprcursor.pc; do
		if [ -f "$pc" ]; then
			echo 'Requires: libzip tomlplusplus' >>"$pc"
		fi
	done
}


hyprcursor-devel_package() {
	depends="hyprcursor-${version}_${revision} libzip-devel tomlplusplus-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}
