# Template file for 'librewolf'
pkgname=librewolf
version=153.0.4.1
revision=1
archs="x86_64"
wrksrc="librewolf"
nodebug=yes
depends="desktop-file-utils hicolor-icon-theme ca-certificates ffmpeg
 libpulseaudio nss"
short_desc="Community fork of Firefox focused on privacy and freedom"
maintainer="Dicov <SrDicov@gmail.com>"
license="MPL-2.0"
homepage="https://librewolf.net"
changelog="https://codeberg.org/librewolf/source/releases"
distfiles="https://codeberg.org/api/packages/librewolf/generic/librewolf/153.0.4-1/librewolf-153.0.4-1-linux-x86_64-package.tar.xz"
checksum=28fbf8e3e175a1fabb2f625ae9733802d22eb480927c9cfa47b5ef92f947e58d

do_install() {
	# upstream binary tree, built against glibc (see archs)
	vmkdir usr/lib/librewolf
	vcopy "*" usr/lib/librewolf

	# /usr/bin wrapper (mirrors Arch librewolf-bin)
	vmkdir usr/bin
	printf '#!/bin/sh\nexec /usr/lib/librewolf/librewolf "$@"\n' \
		> ${DESTDIR}/usr/bin/librewolf
	chmod 755 ${DESTDIR}/usr/bin/librewolf
	# replace duplicate binary with symlink (mozilla#658850)
	rm -f ${DESTDIR}/usr/lib/librewolf/librewolf-bin
	ln -s /usr/bin/librewolf ${DESTDIR}/usr/lib/librewolf/librewolf-bin

	# system dictionaries + distributor identity
	mkdir -p ${DESTDIR}/usr/lib/librewolf/browser/defaults/preferences \
		${DESTDIR}/usr/lib/librewolf/distribution
	cat > ${DESTDIR}/usr/lib/librewolf/browser/defaults/preferences/vendor.js \
		<<-EOF
	// Use system-provided dictionaries
	pref("spellchecker.dictionary_path", "/usr/share/hunspell");
	EOF
	cat > ${DESTDIR}/usr/lib/librewolf/distribution/distribution.ini <<-EOF
	[Global]
	id=io.gitlab.librewolf-community
	version=1.0
	about=LibreWolf

	[Preferences]
	app.distributor="LibreWolf Community"
	app.distributor.channel=librewolf
	app.partner.librewolf=librewolf
	EOF

	# icons from bundled branding
	for s in 16 32 48 64 128; do
		vinstall browser/chrome/icons/default/default${s}.png 644 \
			usr/share/icons/hicolor/${s}x${s}/apps librewolf.png
	done
	vinstall browser/chrome/icons/default/default16.png 644 \
		usr/share/icons/hicolor/symbolic/apps librewolf-symbolic.png

	vinstall ${FILESDIR}/librewolf.desktop 644 usr/share/applications
}
