# Z: glibc-only (binarios precompilados x86_64).
pkgname=goverlay-bin
version=1.9.2
revision=2
only_for_archs="x86_64"
depends="MangoHud qt6-base qt6-declarative gamemode nerd-fonts libqt6pas-bin python3"
hostmakedepends="tar xz" 
short_desc="Modern Qt6 GUI application to configure MangoHud, vkBasalt, and more"
maintainer="JavierC"
license="GPL-3.0-or-later"
homepage="https://github.com/benjamimgois/Goverlay"
distfiles="https://github.com/benjamimgois/goverlay/releases/download/${version}/goverlay-${version}-x86_64.deb"
checksum=b2f81ed6ced15a2ebc9950ec60bd765a104938e29fd463567761247d1c875ec3
nopie=yes
conflicts="goverlay>=0"
provides="goverlay-${version}_${revision}"

do_extract() {
    ar x ${XBPS_SRCDISTDIR}/${pkgname}-${version}/goverlay-${version}-x86_64.deb
}

do_install() {
    tar xf data.tar.* -C ${DESTDIR}
}
