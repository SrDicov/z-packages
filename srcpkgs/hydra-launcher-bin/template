# Template file for 'hydra-launcher-bin'
pkgname=hydra-launcher-bin
version=4.2.0
revision=1
archs="x86_64"
create_wrksrc=yes
hostmakedepends="bsdtar"
depends="gtk+3 nss alsa-lib nspr at-spi2-core libsecret libnotify libXtst
 libXScrnSaver eudev-libudev libcups libXrandr libXcomposite libXdamage
 mesa-dri xrandr hicolor-icon-theme p7zip python3 libtorrent-rasterbar-python3
 xdg-utils"
short_desc="Game launcher with built-in bittorrent client"
maintainer="ANOMALI0x00 <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/hydralauncher/hydra"
distfiles="https://github.com/hydralauncher/hydra/releases/download/v${version}/hydralauncher_${version}_amd64.deb"
checksum=3982e1ba4026f436378b54bce831f0dd340833b574325950a7dbf03c363b215a
python_version=3.14
replaces="hydra-launcher>=0"

nostrip=yes
noverifyrdeps=yes

do_extract() {
	bsdtar -xf ${XBPS_SRCDISTDIR}/${pkgname}-${version}/hydralauncher_${version}_amd64.deb -C ${wrksrc}
	bsdtar -xf ${wrksrc}/data.tar.* -C ${wrksrc}
}

do_install() {
	vmkdir opt
	vmkdir usr/bin
	vmkdir usr/share

	if [ -d "${wrksrc}/opt/Hydra" ]; then
		vcopy opt/Hydra opt/


		vmkdir opt/Hydra/resources/app.asar.unpacked/python

		if [ -f "${FILESDIR}/main.py" ]; then
			vcopy "${FILESDIR}/main.py" opt/Hydra/resources/app.asar.unpacked/python/
			vcopy "${FILESDIR}/torrent_downloader.py" opt/Hydra/resources/app.asar.unpacked/python/
		elif [ -f "${wrksrc}/main.py" ]; then
			vcopy main.py opt/Hydra/resources/app.asar.unpacked/python/
			vcopy torrent_downloader.py opt/Hydra/resources/app.asar.unpacked/python/
		fi


		RPC_DIR="${DESTDIR}/opt/Hydra/resources/hydra-python-rpc"
		if [ -d "${RPC_DIR}" ]; then
			rm -rf ${RPC_DIR}/*
			vmkdir opt/Hydra/resources/hydra-python-rpc/bin

			ln -sf /usr/bin/python3 ${RPC_DIR}/python3
			ln -sf /usr/bin/python3 ${RPC_DIR}/python
			ln -sf /usr/bin/python3 ${RPC_DIR}/bin/python


			vinstall "${FILESDIR}/hydra-python-rpc" 755 opt/Hydra/resources/hydra-python-rpc
			chmod 755 ${RPC_DIR}/hydra-python-rpc
		fi


		if [ -f "${DESTDIR}/opt/Hydra/chrome-sandbox" ]; then
			chmod 4755 ${DESTDIR}/opt/Hydra/chrome-sandbox
		fi


		mv ${DESTDIR}/opt/Hydra/hydralauncher ${DESTDIR}/opt/Hydra/hydralauncher.bin

		vinstall "${FILESDIR}/hydralauncher" 755 opt/Hydra

		chmod 755 ${DESTDIR}/opt/Hydra/hydralauncher
		ln -sf /opt/Hydra/hydralauncher ${DESTDIR}/usr/bin/hydra-launcher
	fi


	if [ -d "${wrksrc}/usr/share/applications" ]; then
		vcopy usr/share/applications usr/share/
	fi

	if [ -d "${wrksrc}/usr/share/icons" ]; then
		vcopy usr/share/icons usr/share/
	fi


	vmkdir usr/share/pixmaps
	if [ -f "${DESTDIR}/usr/share/icons/hicolor/512x512/apps/hydralauncher.png" ]; then
		ln -sf /usr/share/icons/hicolor/512x512/apps/hydralauncher.png ${DESTDIR}/usr/share/pixmaps/hydralauncher.png
		ln -sf /usr/share/icons/hicolor/512x512/apps/hydralauncher.png ${DESTDIR}/usr/share/pixmaps/hydra-launcher.png
	fi

	if [ -f "${DESTDIR}/opt/Hydra/LICENSE.electron.txt" ]; then
		vlicense opt/Hydra/LICENSE.electron.txt
	fi
}

post_install() {
	find ${DESTDIR}/opt/Hydra -type f \( -name "liblog.so" -o -name "libc.musl-x86_64.so.1" -o -name "*.pyc" \) -delete 2>/dev/null || true
	chmod -R o-w ${DESTDIR}/opt/Hydra
}
