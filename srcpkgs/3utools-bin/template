# Z: glibc-only (binario precompilado x86_64).
pkgname=3utools-bin
version=9.03.003
revision=1
archs="x86_64"
nostrip=yes
nopie=yes
noshlibprovides=yes
noverifyrdeps=yes
hostmakedepends="bsdtar patchelf file"
depends="hicolor-icon-theme libglvnd usbmuxd usbutils psmisc desktop-file-utils"
short_desc="Apple device management and jailbreak tool"
maintainer="Orphaned <orphan@voidlinux.org>"
license="custom:Proprietary"
homepage="https://www.3u.com"
_site="https://dl.3u.com/update/v900/dl/linux/x64"
distfiles="${_site}/com.3u.3utools_${version}_amd64.deb"
checksum=3431e97e5b2dde0c1f8365ef5e0c15d79a11572d58dc0236029777a76b596fef

do_extract() {
    local d="${XBPS_SRCDISTDIR}/${pkgname}-${version}"

    bsdtar -xf "$d/com.3u.3utools_${version}_amd64.deb" -C "${wrksrc}"
    local _data
    _data=$(ls "${wrksrc}"/data.tar.* 2>/dev/null | head -n1)
    if [ -z "${_data}" ]; then
        msg_error "No se encontro data.tar.* dentro del .deb\n"
    fi
    bsdtar -xf "${_data}" -C "${wrksrc}"
    rm -f "${wrksrc}"/control.tar.* "${wrksrc}"/debian-binary \
        "${wrksrc}"/data.tar.*
}

do_install() {
    vcopy opt opt

    # El .deb guarda todo el payload bajo opt/apps/, no bajo usr/: el
    # .desktop y el icono estan en opt/apps/com.3u.3utools/share/.
    _app="opt/apps/com.3u.3utools/share"
    if [ -f "${_app}/applications/com.3u.3utools.desktop" ]; then
        vinstall "${_app}/applications/com.3u.3utools.desktop" \
            644 usr/share/applications
    fi

    if [ -f "${_app}/icons/hicolor/scalable/apps/com.3u.3utools.svg" ]; then
        vinstall "${_app}/icons/hicolor/scalable/apps/com.3u.3utools.svg" \
            644 usr/share/icons/hicolor/scalable/apps
    fi

    vinstall "${FILESDIR}/38-3uTools.rules" 644 usr/lib/udev/rules.d
}

post_install() {
    local appdir="${DESTDIR}/opt/apps/com.3u.3utools"
    local libdir="${appdir}/lib"
    local rpath="/opt/apps/com.3u.3utools/lib:/usr/lib:/lib"

    if [ ! -d "$appdir" ]; then
        return 0
    fi

    chmod -R u+w "$appdir"

    find "$appdir" -type f -perm -u+x -print0 | \
        while IFS= read -r -d '' f; do
            file -b "$f" | grep -q ELF || continue
            patchelf --set-interpreter /lib64/ld-linux-x86-64.so.2 "$f" \
                2>/dev/null || true
            patchelf --print-needed "$f" 2>/dev/null | \
                grep '^\./lib/' | while read -r lib; do
                    patchelf --replace-needed "$lib" "$(basename "$lib")" \
                        "$f" 2>/dev/null || true
                done
            patchelf --force-rpath --set-rpath "$rpath" "$f" \
                2>/dev/null || true
        done

    if [ -d "$libdir" ]; then
        find "$libdir" -maxdepth 1 -type f -name '*.so*' -print0 | \
            while IFS= read -r -d '' so; do
                patchelf --force-rpath --set-rpath "$rpath" "$so" \
                    2>/dev/null || true
            done
        rm -f "$libdir/libc.so.6" "$libdir/ld-linux-x86-64.so.2"
    fi

    local dfile="${DESTDIR}/usr/share/applications/com.3u.3utools.desktop"
    if [ -f "$dfile" ]; then
        vsed -i 's/^Name=.*/Name=3uTools/' "$dfile"
    fi
}
