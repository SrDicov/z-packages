version=7.3.0
revision=5
archs="x86_64*"
create_wrksrc=yes
short_desc="Custom RT kernel precompiled for Void Linux + HEADERS"
maintainer="JavierC <franckeycool@gmail.com>"
license="GPL-2.0-only"
homepage="https://github.com/Neko-Void-Linux/kernel-neko-void"
_flavor="rt-neko+"
distfiles="https://github.com/Neko-Void-Linux/kernel-neko-void/releases/download/latest/neko-kernel-void-${version}-rt-neko+.tar.gz"
