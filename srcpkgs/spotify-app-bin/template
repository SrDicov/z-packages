# Z: glibc-only (binario precompilado x86_64).
pkgname=spotify-app-bin
version=1.3.4
revision=1
_subver=258.gc60b10b0946a
archs="x86_64"
create_wrksrc=yes
nostrip=yes
noshlibprovides=yes
hostmakedepends="bsdtar"
depends="libcurl libayatana-appindicator libatomic"
short_desc="Proprietary music streaming client"
maintainer="Orphaned <orphan@voidlinux.org>"
license="custom:Proprietary"
homepage="https://www.spotify.com"
_site="https://repository.spotify.com/pool/non-free/s/spotify-client"
distfiles="${_site}/spotify-client_${version}.${_subver}_amd64.deb"
checksum=20f327441d11b202c82e65b69ec990ef631eb66605da15f41076c049acb718e4

do_extract() {
    local d="${XBPS_SRCDISTDIR}/${pkgname}-${version}"

    bsdtar -xf "$d/spotify-client_${version}.${_subver}_amd64.deb"
    bsdtar -xf data.tar.gz -C "${wrksrc}"
    rm -f control.tar.* debian-binary data.tar.*
}

do_install() {
    vbin "${FILESDIR}/spotify"

    vmkdir usr/share/spotify
    vmkdir usr/libexec
    vcopy usr/share/spotify usr/libexec

    ln -s "../../libexec/spotify/icons" "${DESTDIR}/usr/share/spotify/"

    # install icons
    for _s in 16 22 24 32 48 64 128 256 512; do
        vmkdir "usr/share/icons/hicolor/${_s}x${_s}/apps"
        icon="usr/share/icons/hicolor/${_s}x${_s}/apps/spotify-client.png"
        ln -sf "/usr/share/spotify/icons/spotify-linux-${_s}.png" \
            "${DESTDIR}/${icon}"
    done

    vmkdir usr/share/applications
    vinstall "${DESTDIR}/usr/libexec/spotify/spotify.desktop" 644 \
        usr/share/applications
    rm -f "${DESTDIR}/usr/libexec/spotify/spotify.desktop"

    # provide dynamic libraries
    ln -s /usr/lib/libcurl.so.4 \
        "${DESTDIR}/usr/libexec/spotify/libcurl-gnutls.so.4"

    vlicense "${FILESDIR}/EULA"
}
