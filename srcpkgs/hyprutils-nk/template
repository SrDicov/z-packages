# Template file for 'hyprutils-nk'
pkgname=hyprutils-nk
version=0.14.3
revision=1
build_style=cmake
configure_args="-DBUILD_TESTING=OFF"
hostmakedepends="pkg-config pixman-devel"
short_desc="Hyprland utilities library used across the ecosystem"
maintainer="Dicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprutils"
distfiles="https://github.com/hyprwm/hyprutils/archive/refs/tags/v${version}.tar.gz"
checksum=87bbfc9549ed96316b0d592c16d01f58729b23a2999a5293b73eec620b40c5f5
provides="hyprutils-${version}_${revision}"
replaces="hyprutils>=0"

post_install() {
	vlicense LICENSE
	for pc in "$PKGDESTDIR"/usr/lib{,64}/pkgconfig/hyprutils.pc; do
		if [ -f "$pc" ]; then
			if ! grep -q '^Requires: pixman-1$' "$pc"; then
				echo 'Requires: pixman-1' >>"$pc"
			fi
		fi
	done
}

hyprutils-nk-devel_package() {
	replaces="hyprutils-devel>=0"
	provides="hyprutils-devel-${version}_${revision}"
	depends="${sourcepkg}>=${version}_${revision} pixman-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}
