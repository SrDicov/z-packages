# Z: glibc-only (binario precompilado x86_64).
pkgname=artcraft-launcher-bin
version=0.6.1
revision=1
archs="x86_64"
nostrip=yes
wrksrc="artcraft-launcher-${version}-linux-x86_64"
depends="hicolor-icon-theme libxkbcommon ca-certificates"
short_desc="Install, update and launch the Craft App Suite"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT, Apache-2.0"
homepage="https://getartcraft.com/apps"
changelog="https://github.com/storytold/craft-launcher/releases"
_gh="https://github.com/storytold/craft-launcher/releases/download/v${version}"
distfiles="${_gh}/artcraft-launcher-${version}-linux-x86_64.tar.gz"
checksum=46c9fcdbc72a82245e544a5804d305d05795ada2e17825615b54a4e3fe614881

do_install() {
    vbin bin/artcraft-launcher
    vinstall share/applications/ai.storyteller.artcraft-launcher.desktop 644 \
        usr/share/applications
    vinstall share/metainfo/ai.storyteller.artcraft-launcher.metainfo.xml 644 \
        usr/share/metainfo
    vmkdir usr/share
    vcopy share/icons usr/share
    vlicense share/doc/artcraft-launcher/LICENSE-MIT
    vlicense share/doc/artcraft-launcher/LICENSE-APACHE
    vdoc share/doc/artcraft-launcher/README.md
    vdoc share/doc/artcraft-launcher/ATTRIBUTION.md
    vdoc share/doc/artcraft-launcher/NOTICE
}
