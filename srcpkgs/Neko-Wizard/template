# Template file for 'Neko-Wizard'
pkgname=Neko-Wizard
version=9.0.25
revision=3
_commit=a23ff4face40874a6fe1c62aab9e3f60d4230329
build_style=meson
hostmakedepends="pkg-config meson ninja cmake"
makedepends="gtk4-devel"
short_desc="Wizard Post Install for NEKO VOID"
maintainer="JavierC <javiercyt@atomicmail.io>"
license="WTFPL"
homepage="https://github.com/Neko-Void-Linux/Neko-Wizard"
distfiles="https://github.com/Neko-Void-Linux/Neko-Wizard/archive/${_commit}.tar.gz>${pkgname}-${version}.tar.gz"
checksum=e824125da56bfb953b58540f6c0acba796239ea2e273fd41c36e7233251b85ca

do_extract() {
	vsrcextract --strip-components=1 ${pkgname}-${version}.tar.gz
}

do_install() {
	vmkdir usr/lib/Neko-Wizard
	vmkdir usr/bin
	vmkdir usr/share/applications
	vmkdir etc/xbps.d
	vcopy build/neko-store usr/lib/Neko-Wizard/neko-store
	chmod 755 "${DESTDIR}/usr/lib/Neko-Wizard/neko-store"

	vcopy resources usr/lib/Neko-Wizard/resources
	vcopy xbps.d/20-repository-neko.conf etc/xbps.d
	vcopy data usr/lib/Neko-Wizard/data

	ln -s ../lib/Neko-Wizard/neko-store "${DESTDIR}/usr/bin/neko-store"

	echo "[Desktop Entry]" > "${DESTDIR}/usr/share/applications/neko-store.desktop"
	echo "Type=Application" >> "${DESTDIR}/usr/share/applications/neko-store.desktop"
	echo "Name=Neko Wizard" >> "${DESTDIR}/usr/share/applications/neko-store.desktop"
	echo "Comment=WIZARD for INSTALL Software and DRIVERS" >> "${DESTDIR}/usr/share/applications/neko-store.desktop"
	echo "Exec=neko-store" >> "${DESTDIR}/usr/share/applications/neko-store.desktop"
	echo "Icon=system-software-install" >> "${DESTDIR}/usr/share/applications/neko-store.desktop"
	echo "Categories=Utility;" >> "${DESTDIR}/usr/share/applications/neko-store.desktop"
	echo "Terminal=false" >> "${DESTDIR}/usr/share/applications/neko-store.desktop"
	chmod 644 "${DESTDIR}/usr/share/applications/neko-store.desktop"

	if [ -f LICENSE ]; then
		vlicense LICENSE
	fi
}
