# Template file for 'Neko-Wizard'
pkgname=Neko-Wizard
version=9.0.23
revision=1
build_style=meson
hostmakedepends="pkg-config meson ninja cmake git"
makedepends="gtk4-devel"
short_desc="Wizard Post Install for NEKO VOID"
maintainer="Orphaned <orphan@voidlinux.org>"
license="WTFPL"
homepage="https://github.com/SrDicov/Neko-Wizard"
_commit="74b7a6c6cc7d56fc8b13571cd1d2fed5e6844081"
_repository="https://github.com/SrDicov/Neko-Wizard.git"

do_fetch() {
	msg_normal "Cloning ${_repository} @ ${_commit}...\n"
	git clone "${_repository}" ${pkgname}-${version}
	(cd ${pkgname}-${version} && git checkout -q ${_commit})
}

do_install() {
	vmkdir usr/lib/Neko-Wizard
	vmkdir usr/bin
	vmkdir usr/share/applications
	vcopy build/neko-store usr/lib/Neko-Wizard/neko-store
	chmod 755 "${DESTDIR}/usr/lib/Neko-Wizard/neko-store"

	vcopy resources usr/lib/Neko-Wizard/resources
	vcopy data usr/lib/Neko-Wizard/data

	ln -s ../lib/Neko-Wizard/neko-store "${DESTDIR}/usr/bin/neko-store"

	vinstall ${FILESDIR}/neko-store.desktop 644 usr/share/applications

	if [ -f LICENSE ]; then
		vlicense LICENSE
	fi
}
