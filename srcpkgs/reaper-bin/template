# Z: glibc-only (binarios precompilados x86_64).
pkgname=reaper-bin
version=7.81
revision=1
archs="x86_64"
create_wrksrc=yes
hostmakedepends="binutils tar xz"
short_desc="Digital audio workstation and MIDI sequencer"
maintainer="Dicov <SrDicov@gmail.com>"
license="custom:Reaper EULA"
homepage="https://www.reaper.fm"
distfiles="https://www.reaper.fm/files/7.x/reaper781_linux_x86_64.tar.xz>reaper-${version}-linux-x86_64.tar.xz"
checksum=d5654868a0f4f31a30b251b54fffc32ca9ac578d99815e87c00903d4b9f788b9
# Reaper ships its own libSwell (SWELL/GTK) and loads GTK plugins via dlopen,
# so the X/GTK stack must be present at runtime. ALSA/pulse for audio.
depends="alsa-lib at-spi2-core cairo dbus desktop-file-utils fontconfig
 freetype gdk-pixbuf glib gtk+3 libX11 libXcomposite libXcursor libXext
 libXfixes libXi libXinerama libXrandr libXrender libXScrnSaver libXt
 libXtst pango pulseaudio xdg-utils"
nostrip=yes
nopie=yes
noshlibprovides=yes

do_extract() {
	# tarball root is reaper_linux_x86_64/{REAPER,install-reaper.sh,
	# readme-linux.txt}; keep the REAPER tree as the package root.
	tar -xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}/reaper-${version}-linux-x86_64.tar.xz" \
		-C "${wrksrc}" --strip-components=1
}

do_install() {
	vmkdir usr/lib/reaper
	# vcopy == cp -a <files> <target>: the CONTENTS of REAPER/ land
	# directly in usr/lib/reaper (no extra REAPER/ level).
	vcopy "REAPER/." usr/lib/reaper
	vmkdir usr/share/licenses/reaper
	vinstall REAPER/EULA.txt 644 usr/share/licenses/reaper

	vmkdir usr/bin
	printf '#!/bin/sh\nexec /usr/lib/reaper/reaper "$@"\n' \
		> "${DESTDIR}/usr/bin/reaper"
	chmod 755 "${DESTDIR}/usr/bin/reaper"
	# REAPER writes config/projects/plugins inside its own dir, so it must
	# stay user-writable: no setuid, plain 755.
	chmod 755 "${DESTDIR}/usr/lib/reaper/reaper" \
		"${DESTDIR}/usr/lib/reaper/libSwell.so"

	vmkdir usr/share/applications
	cat > "${DESTDIR}/usr/share/applications/reaper.desktop" <<-_EOF
	[Desktop Entry]
	Name=REAPER
	Comment=Digital audio workstation and MIDI sequencer
	Exec=reaper %U
	# No Icon=: upstream ships no app icon (only .ico toolbar art), and
	# pointing at a missing file renders a broken image.
	Terminal=false
	Type=Application
	Categories=AudioVideo;Audio;X-Jack;Recorder;
	MimeType=audio/x-reaper;audio/x-reaper-project;
	StartupNotify=true
	_EOF
}
