# Template file for 'ryoku-hypr-plugins'
pkgname=ryoku-hypr-plugins
version=0.1.0
revision=2
archs="x86_64*"
build_style=gnu-makefile
hostmakedepends="git pkg-config"

export CPATH="/usr/include/pixman-1:/usr/include/lua5.5:/usr/include/libdrm:/usr/include/hyprland/src"
makedepends="
 aquamarine-devel cairo-devel glslang-devel hyprcursor-devel
 hyprgraphics-devel hyprland-devel hyprlang-devel hyprutils-nk-devel
 libdisplay-info-devel libdrm-devel libinput-devel libseat-devel
 libxcb-devel libxkbcommon-devel libzip-devel
 lua55-devel MesaLib-devel pango-devel pixman-devel tomlplusplus-devel
 wayland-devel xcb-util-errors-devel xcb-util-wm-devel
"
depends="hyprland"
short_desc="Hyprland plugins shipped with Ryoku: bars, focus and borders"
maintainer="Dicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprland-plugins"

do_fetch() {
	git clone --depth 1 https://github.com/hyprwm/hyprland-plugins.git "${wrksrc}"
	cd "${wrksrc}"
	local hv commit
	hv="$(sed -n 's/^#define GIT_COMMIT_HASH *"\([^"]*\)".*/\1/p' \
		/usr/include/hyprland/src/version.h)"
	commit="$(grep -F "\"$hv\"" hyprpm.toml | grep -oE '[0-9a-f]{40}' | sed -n 2p)"
	if [ -n "$commit" ]; then
		git fetch --depth 1 origin "$commit"
		git checkout -q "$commit"
	fi
}

do_build() {
	make -C hyprbars all
	make -C hyprfocus all
	make -C borders-plus-plus all
}

do_install() {
	vinstall hyprbars/hyprbars.so 755 usr/lib/hyprland/plugins hyprbars.so
	vinstall hyprfocus/hyprfocus.so 755 usr/lib/hyprland/plugins hyprfocus.so
	vinstall borders-plus-plus/borders-plus-plus.so 755 usr/lib/hyprland/plugins borders-plus-plus.so
}

post_install() {
	vlicense LICENSE
	local h=/usr/include/hyprland/src/version.h
	local abi v
	abi="$(sed -n 's/^#define GIT_COMMIT_HASH *"\([^"]*\)".*/\1/p' "$h")"
	for v in AQUAMARINE:aq HYPRUTILS:hu HYPRGRAPHICS:hg HYPRCURSOR:hc \
		HYPRLANG:hlg; do
		abi="${abi}_${v#*:}_$(sed -n "s/^#define ${v%:*}_VERSION *\"\([^\"]*\)\".*/\1/p" \
			"$h" | sed 's/\.[^.]*$//')"
	done
	for so in hyprbars hyprfocus borders-plus-plus; do
		printf '%s\n' "$abi" \
			>"${PKGDESTDIR}/usr/lib/hyprland/plugins/${so}.abi"
	done
}
