# Template file for 'ryoku-hypr-plugins'
pkgname=ryoku-hypr-plugins
version=0.1.0
revision=1
build_style=gnu-makefile
hostmakedepends="git pkg-config"
makedepends="
 aquamarine-devel cairo-devel hyprcursor-devel hyprgraphics-devel
 hyprland-devel hyprlang-devel hyprutils-devel libdrm-devel
 libinput-devel libxcb-devel libxkbcommon-devel MesaLib-devel pango-devel
 pixman-devel wayland-devel xcb-util-errors-devel xcb-util-wm-devel
"
depends="hyprland"
short_desc="Hyprland plugins shipped with Ryoku: bars, focus and borders"
maintainer="Dicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprland-plugins"

do_fetch() {
	git clone --depth 1 https://github.com/hyprwm/hyprland-plugins.git "${wrksrc}"
}

do_build() {
	make -C hyprbars all
	make -C hyprfocus all
	make -C borders-plus-plus all
}

do_install() {
	# Hyprland loads plugins from its own directory
	install -Dm755 hyprbars/hyprbars.so \
		"${DESTDIR}/usr/lib/hyprland/plugins/hyprbars.so"
	install -Dm755 hyprfocus/hyprfocus.so \
		"${DESTDIR}/usr/lib/hyprland/plugins/hyprfocus.so"
	install -Dm755 borders-plus-plus/borders-plus-plus.so \
		"${DESTDIR}/usr/lib/hyprland/plugins/borders-plus-plus.so"
}

post_install() {
	vlicense LICENSE
	# the receipt records the compositor ABI the plugins were built for
	local h=/usr/include/hyprland/src/version.h
	local abi v
	abi="$(sed -n 's/^#define GIT_COMMIT_HASH *"\([^"]*\)".*/\1/p' "$h")"
	for v in AQUAMARINE:aq HYPRUTILS:hu HYPRGRAPHICS:hg HYPRCURSOR:hc \
		HYPRLANG:hlg; do
		abi="${abi}_${v#*:}_$(sed -n "s/^#define ${v%:*}_VERSION *\"\([^\"]*\)\".*/\1/p" \
			"$h" | sed 's/\.[^.]*$//')"
	done
	for so in hyprbars hyprfocus borders-plus-plus; do
		printf '%s\n' "$abi" \
			>"${PKGDESTDIR}/usr/lib/hyprland/plugins/${so}.abi"
	done
}
