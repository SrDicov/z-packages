# Template file for 'lua55'
pkgname=lua55
version=5.5.1
revision=3
makedepends="readline-devel"
short_desc="Powerful, fast, lightweight scripting language (5.5.x)"
maintainer="Dicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://www.lua.org"
distfiles="https://www.lua.org/ftp/lua-${version}.tar.gz"
checksum=1c4b4068d67061f2a2231ad2b5422e77acea1487ea9890f6320af614f4373dce

do_build() {
	vsed -i src/Makefile -r \
		-e '/^LUA_(SO|A|T)=/ s;lua;lua5.5;' \
		-e '/^LUAC_T=/ s;luac;luac5.5;'
	make MYCFLAGS="$CFLAGS -fPIC" MYLDFLAGS="$LDFLAGS" \
		CC="$CC" RANLIB="$RANLIB" ${makejobs} linux
	${CC} -shared -Wl,-soname,liblua5.5.so.5.5 \
		-Wl,--whole-archive src/liblua5.5.a -Wl,--no-whole-archive \
		${LDFLAGS} -ldl -lm -o src/liblua5.5.so.5.5.1
	ln -sf liblua5.5.so.5.5.1 src/liblua5.5.so.5.5
	ln -sf liblua5.5.so.5.5 src/liblua5.5.so
}

do_install() {
	make INSTALL_DATA="cp -d" INSTALL_TOP="${DESTDIR}/usr" \
		TO_BIN="lua5.5 luac5.5" \
		TO_LIB="liblua5.5.a liblua5.5.so liblua5.5.so.5.5 liblua5.5.so.5.5.1" \
		INSTALL_INC="${DESTDIR}/usr/include/lua5.5" \
		INSTALL_MAN="${DESTDIR}/usr/share/man/man1" install

	sed ${FILESDIR}/lua.pc \
		-e "s;%VER%;${version%.*};g;s;%REL%;${version};g" \
		> lua5.5.pc

	vinstall lua5.5.pc 644 usr/lib/pkgconfig

	rm -f doc/*.1
	vmkdir usr/share/doc/lua55
	vcopy "doc/." usr/share/doc/lua55

	vlicense doc/readme.html

	mv ${DESTDIR}/usr/share/man/man1/lua{,5.5}.1
	mv ${DESTDIR}/usr/share/man/man1/luac{,5.5}.1
}

lua55-devel_package() {
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
		vmove usr/share/doc
	}
}
