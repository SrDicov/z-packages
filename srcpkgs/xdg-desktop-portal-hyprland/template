# Template file for 'xdg-desktop-portal-hyprland'
pkgname=xdg-desktop-portal-hyprland
version=1.4.1
revision=3
build_style=cmake
configure_args="-DSYSTEMD_SERVICES=OFF -DCMAKE_INSTALL_LIBEXECDIR=/usr/lib"
hostmakedepends="cmake clang ninja pkg-config"
makedepends="
 elogind-devel hyprland-protocols hyprlang-devel hyprutils-devel
 hyprwayland-scanner libdrm-devel libgbm-devel pipewire-devel
 pugixml-devel qt6-base-devel sdbus-c++-devel wayland-devel
 wayland-protocols
"
depends="hyprlang hyprutils hyprland-protocols hyprwayland-scanner sdbus-c++
 xdg-desktop-portal pipewire qt6-base qt6-wayland"
short_desc="Backend of xdg-desktop-portal for Hyprland"
maintainer="Dicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/xdg-desktop-portal-hyprland"
distfiles="https://github.com/hyprwm/xdg-desktop-portal-hyprland/archive/refs/tags/v${version}.tar.gz"
checksum=3652c14f63a9666acea2c841e196782dbc0f74ea5b4783622dd04a32f08b709f

pre_configure() {
	export CC=clang
	export CXX=clang++
	configure_args+=" -DCMAKE_C_COMPILER=$CC -DCMAKE_CXX_COMPILER=$CXX
 -DCMAKE_CXX_STANDARD=23 -DCMAKE_CXX_FLAGS=-stdlib=libstdc++
 -DCMAKE_EXE_LINKER_FLAGS=-stdlib=libstdc++
 -DCMAKE_SHARED_LINKER_FLAGS=-stdlib=libstdc++"
}

post_install() {
	vlicense LICENSE
}
