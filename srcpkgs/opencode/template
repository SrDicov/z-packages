# Template file for 'opencode'
pkgname=opencode
version=2.2.0
revision=1
archs="x86_64"
hostmakedepends="tar"
depends="ripgrep"
short_desc="AI coding agent built for the terminal"
maintainer="Soanvig <soanvig@gmail.com>"
license="MIT"
homepage="https://opencode.ai"
distfiles="https://github.com/anomalyco/opencode/releases/download/v${version}/opencode-linux-x64.tar.gz>opencode-bin_${version}_x86_64.tar.gz"
checksum=6d597970a8cc448f1b9a9f645532584b339dd3ab9583bb5f063f13d83e54768f
replaces="opencode-bin>=0"
provides="opencode-bin-${version}_${revision}"
nostrip=yes
nopie=yes

do_extract() {
	tar -xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}/opencode-bin_${version}_x86_64.tar.gz" -C "${wrksrc}"
}

do_install() {
	vlicense "${FILESDIR}/LICENSE"
	vmkdir usr/bin
	vbin opencode
}
